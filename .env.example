# Salin file ini jadi .env lalu isi nilainya. Jangan commit .env.

# Token dari @BotFather
BOT_TOKEN=123456:ABC-your-token

# Opsional: Google Sheets (kosongkan jika fitur sheets dimatikan)
# Service account JSON dari Google Cloud, taruh di folder ini lalu isi path-nya
GOOGLE_SERVICE_ACCOUNT_JSON=./service_account.json
GOOGLE_SHEET_ID=
GOOGLE_SHEET_RANGE=Sheet1!A:B

# Chat id penerima broadcast default (opsional, bisa juga lewat /broadcast)
DEFAULT_BROADCAST_CHAT_ID=
